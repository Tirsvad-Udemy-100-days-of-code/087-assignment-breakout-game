# Doxygen configuration for Breakout. Run: doxygen Doxyfile
# Output goes to build/doxygen/html (ignored by git).
PROJECT_NAME           = "Breakout"
PROJECT_BRIEF          = "Breakout clone built with Python Turtle"
OUTPUT_DIRECTORY       = build/doxygen
INPUT                  = src README.md
USE_MDFILE_AS_MAINPAGE = README.md
FILE_PATTERNS          = *.py *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */__pycache__/*
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
JAVADOC_AUTOBRIEF      = YES
AUTOLINK_SUPPORT       = YES
SOURCE_BROWSER         = YES
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_AS_ERROR          = NO
